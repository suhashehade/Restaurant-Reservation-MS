        <StmtSimple StatementText="&#xD;&#xA;WITH Reservation_Count_CTE AS (&#xD;&#xA;  SELECT COUNT(RestaurantId) AS ReservationsCount, RestaurantId  FROM Reservations  GROUP BY RestaurantId&#xD;&#xA;)&#xD;&#xA;&#xD;&#xA;SELECT r.RestaurantId, r.Name, rr.ReservationsCount AS HighRankRestaurant &#xD;&#xA;FROM Reservation_Count_CTE rr &#xD;&#xA;INNER JOIN Restaurants r ON rr.RestaurantId = r.RestaurantId&#xD;&#xA;WHERE rr.ReservationsCount = (SELECT MAX(ReservationsCount) FROM Reservation_Count_CTE)" StatementId="1" StatementCompId="1" StatementType="SELECT" RetrievedFromCache="false" StatementSubTreeCost="0.0393173" StatementEstRows="1" SecurityPolicyApplied="false" StatementOptmLevel="FULL" QueryHash="0x3F2382AA7E89AE16" QueryPlanHash="0xD001196E312E7F25" StatementOptmEarlyAbortReason="GoodEnoughPlanFound" CardinalityEstimationModelVersion="170">
